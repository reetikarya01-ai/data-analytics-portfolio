      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_1583622621020160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ID])' />
      </column>
      <column caption='Total sales' datatype='real' name='[Calculation_1583622621356033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Order_Value_USD])' />
      </column>
      <column caption='Average OrderValue' datatype='real' name='[Calculation_1583622622097410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Order_Value_USD]) / COUNTD([Order_ID])' />
      </column>
      <column caption='Average Quantity per order' datatype='real' name='[Calculation_1583622622781443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])/COUNTD([Order_ID])' />
      </column>
      <column caption='Paid Status' datatype='real' name='[Calculation_1583622624305156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM ( IF [Payment_Status]= &quot;Paid&quot; THEN &#13;&#10;[Total_Order_Value_USD]&#13;&#10;END)' />
      </column>
      <column caption='Total customers' datatype='integer' name='[Calculation_1583622626275333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID])' />
      </column>
      <column caption='Average Customer Ratings' datatype='real' name='[Calculation_1583622626553862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Customer_Rating])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_1583622627110919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Return_Status]=&quot; Returned&quot; THEN 1 ELSE 0 END)/COUNTD([Customer_ID])' />
      </column>
      <column caption='New Customer per' datatype='real' name='[Calculation_1583622634426377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Is_New_Customer] = True THEN [Customer_ID] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Customer_ID])' />
      </column>
      <column caption='Repeat Customer per' datatype='real' name='[Calculation_1583622634819594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Is_Repeat_Customer] = True THEN [Customer_ID] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Customer_ID])' />
      </column>
